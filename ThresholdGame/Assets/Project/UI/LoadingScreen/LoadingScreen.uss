.loading-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(5, 7, 10);
}

.loading-content {
    align-items: center;
    width: 500px;
}

.loading-title {
    font-size: 28px;
    color: rgb(180, 200, 220);
    letter-spacing: 8px;
    -unity-font-style: bold;
    margin-bottom: 30px;
}

.progress-track {
    width: 100%;
    height: 6px;
    background-color: rgb(25, 30, 40);
    border-radius: 3px;
    overflow: hidden;
}

.progress-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(140, 180, 220);
    transition-property: width;
    transition-duration: 0.15s;
}

.loading-percentage {
    margin-top: 14px;
    font-size: 14px;
    color: rgb(120, 140, 160);
    letter-spacing: 4px;
}
