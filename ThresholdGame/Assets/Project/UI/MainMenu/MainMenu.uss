.root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(8, 10, 14);
}

.background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
}

.content {
    align-items: center;
    justify-content: center;
    width: 480px;
    padding: 40px;
}

.title {
    font-size: 72px;
    color: rgb(220, 230, 240);
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-bottom: 8px;
}

.subtitle {
    font-size: 16px;
    color: rgb(120, 140, 160);
    letter-spacing: 4px;
    margin-bottom: 60px;
}

.buttons {
    width: 100%;
    align-items: stretch;
}

.menu-button {
    height: 52px;
    margin: 6px 0;
    background-color: rgba(20, 25, 35, 0.85);
    border-width: 1px;
    border-color: rgb(60, 75, 95);
    color: rgb(200, 210, 220);
    font-size: 18px;
    letter-spacing: 2px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
    border-radius: 2px;
}

.menu-button:hover {
    background-color: rgba(40, 60, 90, 0.95);
    border-color: rgb(140, 180, 220);
    color: rgb(240, 250, 255);
    scale: 1.02 1.02;
}

.menu-button:active {
    background-color: rgba(70, 100, 140, 1);
    scale: 0.98 0.98;
}

.menu-button--disabled {
    opacity: 0.4;
}
