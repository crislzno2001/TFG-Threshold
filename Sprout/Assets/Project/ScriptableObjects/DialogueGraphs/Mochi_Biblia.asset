  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Mochi_favourite_food
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: bee4efa1-6007-4dea-872a-a1f2fe0e22e2
  contextForAI: "Primer encuentro. Mochi est\xE1 nervioso, intenta parecer elegante.
    Charla ligera de vecinos nuevos y le pregunta a la florista cu\xE1l es su comida
    favorita, reacciona con entusiasmo o drama seg\xFAn la respuesta. "
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter: []
  nextNodes:
  - {fileID: -4686380554113933797}
  openingLine: " Antes de que se me olvide preguntar lo importante: \xBFcu\xE1l es
    tu comida favorita? Necesito saber con qui\xE9n trato."
  conversationTopics: []
  exitCondition: El jugador dice una comida
--- !u!114 &-764910619496357934
MonoBehaviour:
  m_ObjectHideFlags: 0
