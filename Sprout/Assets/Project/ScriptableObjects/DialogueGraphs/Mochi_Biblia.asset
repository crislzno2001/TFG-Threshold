  m_Script: {fileID: 11500000, guid: 511426048eb4ebf46b9184e6496e2b8a, type: 3}
  m_Name: Mochi_askAster
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ChoiceNodeSO
  nodeGuid: 45f24783-56d9-4aca-a052-3c5256198cf9
  contextForAI: "Mochi ha notado raro a Aster y pregunta con curiosidad de cotilla
    ('solo voy a sazonar informaci\xF3n'). Decisi\xF3n moral: contar el secreto de
    Aster, guardarlo, o decirle que hable con Aster directamente."
  prerequisiteFlags:
  - flag: aster_secret_known
    expectedValue: 1
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: mochi_pregunto_por_aster
    value: 1
  nextNodes: []
  openingLine: "Oye\u2026 Aster estaba m\xE1s raro de lo normal. Y para Aster, eso
    es como decir que el mar estaba un poco mojado. \xBFTe cont\xF3 algo personal?"
  choices:
  - condition: el jugador le cuenta a Mochi el secreto de Aster
    nextNode: {fileID: 1121775629063342936}
  - condition: el jugador guarda el secreto o le dice que hable con Aster directamente
    nextNode: {fileID: -90720236137178559}
--- !u!114 &-152919930207516124
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
