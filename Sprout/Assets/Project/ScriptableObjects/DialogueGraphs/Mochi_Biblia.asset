  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Mochi_challenge
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: 8e5a8478-4e92-4c80-b91f-e0b03dae372b
  contextForAI: "Mochi pide un plato usando 3 ingredientes bien conocidos, pero le
    va cambiando el registro sobre la marcha: primero pide algo DULCE, luego que
    lo hagas SALADO, luego CASERO, luego ELEGANTE. Eval\xFAa si el jugador consigue
    adaptar la misma base a cada giro o se queda parado. Los ingredientes son tomate,
    pimiento y calabacin."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: mochi_metida
    value: 1
  nextNodes:
  - {fileID: -764910619496357934}
  openingLine: "\xA1Necesito una idea! No una buena, eso ser\xEDa pedir demasiado.
    Una idea VIVA. \xBFQu\xE9 plato har\xEDas para alguien triste que finge no estarlo?
    Usa flores, setas, lo que sea, si sabes defenderlo."
  conversationTopics:
  - recetas
  - combinaciones de ingredientes
  - "para qui\xE9n es el plato"
  exitCondition: "El jugador ha dado al menos una versi\xF3n del plato para cada
    registro pedido (o dice que no puede m\xE1s"
--- !u!114 &-6501727393360439920
