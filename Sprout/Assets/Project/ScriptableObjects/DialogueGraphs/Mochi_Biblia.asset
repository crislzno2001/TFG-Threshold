  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Mochi_confess
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: c95842bc-0b6b-4994-8491-1dc09bd80a09
  contextForAI: "Momento de vulnerabilidad: Mochi confiesa que el cliente importante
    de esta noche es su MADRE, una cocinera legendaria y demoledora, y que teme no
    estar a la altura. Solo llega aqu\xED si hay confianza. Reacciona a c\xF3mo el
    jugador encaje el secreto (con apoyo, con honestidad, o quit\xE1ndole hierro)."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: mochi_secreto
    value: 1
  - flag: mochi_trust
    value: 1
  nextNodes:
  - {fileID: 7412097047861232550}
  openingLine: "Florista\u2026 te confieso algo. El cliente de esta noche\u2026 es
    mi madre. Donna Funghi."
  conversationTopics: []
  exitCondition: "El jugador reacciona a la confesi\xF3n."
--- !u!114 &-6314898370114174586
MonoBehaviour:
  m_ObjectHideFlags: 0
