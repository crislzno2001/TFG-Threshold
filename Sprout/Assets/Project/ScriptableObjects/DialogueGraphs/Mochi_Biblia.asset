  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Mochi_bye_md
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: edff6e04-a19d-451c-9039-7d2538e46a46
  contextForAI: "Fin del mediod\xEDa, tras el reto de ideas. Se despide para ponerse
    a cocinar la idea antes de que se enfr\xEDe. Terminal."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: glow_mochi_none
    value: 1
  nextNodes: []
  openingLine: "\xA1Basta de ideas, basta! D\xE9jame cocinar esto antes de que se
    ponga rancio en mi cabeza. \xA1Vuelve por la tarde y lo pruebas!"
  transitions: []
