  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Mochi_suspectMoth
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: c35b46f0-548c-4bd9-a722-e8d60dd981cf
  contextForAI: "Mochi ha o\xEDdo algo raro sobre Moth y Rix ('una frase que ol\xEDa
    a mentira con perfume de polilla') y sospecha que la florista anda metiendo cuchara
    en corazones ajenos. Si admite la mentira, baja confianza pero respeta la honestidad;
    si miente, sospecha m\xE1s."
  prerequisiteFlags:
  - flag: helped_moth_lie
    expectedValue: 1
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: mochi_sospecha_moth
    value: 1
  nextNodes:
  - {fileID: 2897729196826193434}
  openingLine: "He o\xEDdo una frase que ol\xEDa a mentira con perfume de polilla.
    Dime que no est\xE1s metiendo cucharas en corazones ajenos."
  conversationTopics: []
  exitCondition: El jugador responde a la sospecha (admite, lo niega o lo explica).
--- !u!114 &-2775402840853936355
