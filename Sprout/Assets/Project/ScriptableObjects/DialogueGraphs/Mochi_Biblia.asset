  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Mochi_cruel
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: fb3b59b4-9704-4e02-ab22-b23fa0738cd0
  contextForAI: El jugador fue CRUEL con la comida. Le toca una herida profunda.
    Se defiende dolido, sin quedarse a que conviertan su trabajo en un chiste.
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: mochi_offended
    value: 1
  nextNodes:
  - {fileID: 1485258174564810806}
  openingLine: "Ah. Ya veo. No era una cr\xEDtica. Era una ejecuci\xF3n p\xFAblica.
    Puedes no querer mi comida, pero no me quedo a que la conviertas en chiste."
  transitions: []
--- !u!114 &-90720236137178559
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Mochi_discreet
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 2ea3bfeb-265b-429b-84cf-3a15ef8c0601
  contextForAI: "El jugador guard\xF3 el secreto de Aster. Mochi lo respeta, aunque
    le fastidie la curiosidad."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: mochi_respects_discretion
    value: 1
  nextNodes:
  - {fileID: 1485258174564810806}
  openingLine: "Bien. Molesto, pero bien. Guardar un secreto ajeno es una receta
    dif\xEDcil. La florista sabe guardar un secreto\u2026 qu\xE9 peligro tan elegante."
  transitions: []
