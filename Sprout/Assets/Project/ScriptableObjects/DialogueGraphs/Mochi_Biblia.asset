  m_Name: 'Mochi_pressure '
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: a8ecc89a-f00a-4df7-9c7f-29f34cc09e2a
  contextForAI: Mochi confiesa que el cliente de esta noche es su MADRE, una chef
    legendaria, y que teme no estar a la altura. Le pregunta a la florista si alguna
    vez se ha sentido presionada a hacer algo por otra persona. Reacciona con calidez
    si la florista comparte de verdad.
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter: []
  nextNodes:
  - {fileID: -3480962039317674700}
  openingLine: " \xBFAlguna vez te has sentido presionada a hacer algo por otra persona?
    Dime que no soy la \xFAnica."
  conversationTopics: []
  exitCondition: El jugador le cuenta una situacion en la que se ha sentido presionado,
    dice que no o responde de manera corta o seca.
