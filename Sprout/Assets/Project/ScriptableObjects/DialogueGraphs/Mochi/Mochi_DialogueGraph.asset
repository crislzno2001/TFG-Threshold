--- !u!114 &1939947329926138997
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: ConversationNode
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: d4fe1190-dc57-46d2-863f-27488c50d231
  contextForAI: "Mochi est\xE1 en pleno ataque de p\xE1nico italiano. Esta noche
    llega un cliente VIP \na su restaurante y solo tiene ingredientes rar\xEDsimos.
    NO revela qui\xE9n es el cliente todav\xEDa. \nHabla con drama italiano exagerado.
    Quiere que la florista la ayude pero est\xE1 \ndemasiado nerviosa para pedirlo
    directamente."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter: []
  nextNodes:
  - {fileID: -6570824603773933646}
  openingLine: "Mamma mia! \xA1Bellissima florista! \xA1Llegas en el peor momento
    de mi VIDA!  Esta noche... ay, esta noche es una CAT\xC1STROFE total..."
  conversationTopics:
  - "pregunta qu\xE9 le pasa o por qu\xE9 est\xE1 nerviosa"
  - "pregunta para qui\xE9n est\xE1 cocinando"
  - "pregunta qu\xE9 ingredientes tiene"
  - intenta calmarla
  exitCondition: "El jugador se ofrece a ayudar a Mochi con la receta, o pregunta
    qu\xE9 puede hacer \r\npara ayudar, o sugiere que entre los dos pueden encontrar
    una soluci\xF3n."
--- !u!114 &2425687486097651592
MonoBehaviour:
  m_ObjectHideFlags: 0
