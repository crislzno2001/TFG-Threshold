  m_Script: {fileID: 11500000, guid: 511426048eb4ebf46b9184e6496e2b8a, type: 3}
  m_Name: ChoiceNode
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ChoiceNodeSO
  nodeGuid: 292b061f-550d-4bbb-836b-c37b37214c2b
  contextForAI: "Mochi ha cocinado un primer intento experimental con lo que ten\xEDa.
    \r\nLo sirve con orgullo nervioso. El jugador prueba el plato. La reacci\xF3n
    \r\ndel jugador define c\xF3mo contin\xFAa la trama: si miente amablemente Mochi
    \r\ngana confianza, si es brutalmente honesto Mochi se ofende, si evade \r\nel
    tema Mochi se queda en duda."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter: []
  nextNodes: []
  choices:
  - condition: "el jugador dice que est\xE1 delicioso o lo elogia (mentira amable)"
    nextNode: {fileID: -2598475515629458399}
  - condition: "el jugador es brutalmente honesto y dice que est\xE1 horrible o mal "
    nextNode: {fileID: -2566515947414663357}
  - condition: 'el jugador evade, da una respuesta neutra o no dice nada claro  '
    nextNode: {fileID: -2566515947414663357}
