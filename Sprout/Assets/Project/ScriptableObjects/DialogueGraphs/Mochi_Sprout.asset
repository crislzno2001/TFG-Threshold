  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Mochi_talk
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: a2a80c2f-b20f-4285-b153-919ec3c9b4db
  contextForAI: "Mochi, hongo chef italiano, en pleno ataque de p\xE1nico. Le han
    llegado ingredientes raros (Sal de luna, Hongo susurrante, Fruta espejo) y debe
    improvisar un plato para un cliente importante esta noche. Dram\xE1tico, oversharing,
    cari\xF1oso."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: mochi_metida
    value: 1
  nextNodes:
  - {fileID: 3835125810585759081}
  openingLine: "Mamma mia! \xA1Florista! \xBFHas comido? Esa cara dice que no. \xA1Y
    yo en plena CAT\xC1STROFE!"
  conversationTopics: []
  exitCondition: El jugador se ofrece a ayudar con la receta o pregunta por los ingredientes.
