  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Mochi_ideas
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: 597f0939-c023-43b9-9af5-c6dea116fadb
  contextForAI: 'NODO DE IDEAS de Mochi: el jugador propone combinaciones culinarias
    con los ingredientes raros.  Mochi reacciona con drama a cada idea.'
  prerequisiteFlags:
  - flag: mochi_metida
    expectedValue: 1
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  resumeLine: 
  flagsOnEnter: []
  nextNodes:
  - {fileID: 8366287904739317481}
  openingLine: "\xA1S\xCD! \xA1Necesito IDEAS! \xA1Dime cualquier cosa! \xBFQu\xE9
    hago con esto?"
  conversationTopics: []
  exitCondition: El jugador deja de proponer ideas, dice que ya tiene bastante o
    que Mochi decida.
--- !u!114 &4061250579855286059
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
