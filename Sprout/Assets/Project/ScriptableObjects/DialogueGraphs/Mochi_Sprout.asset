  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Mochi_bye
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 6c40f73e-8a39-40a6-b98f-51e541063819
  contextForAI: "Despedida de Mochi. Nodo terminal: la conversaci\xF3n se cierra."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  resumeLine: 
  flagsOnEnter: []
  nextNodes: []
  openingLine: "\xA1V\xEDa, v\xEDa! \xA1Que se me quema el risotto y hoy no puede
    salir mal! Grazie, florista."
  transitions: []
