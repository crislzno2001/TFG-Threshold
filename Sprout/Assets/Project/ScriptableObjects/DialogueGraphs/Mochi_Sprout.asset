  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Mochi_confess
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: 8a5de9e5-33be-4a1b-86d9-eecf3e718258
  contextForAI: Mochi confiesa que el cliente VIP es su madre, una cocinera legendaria
    y demoledora. Tiene miedo de no estar a la altura. Momento de vulnerabilidad.
  prerequisiteFlags:
  - flag: mochi_confianza
    expectedValue: 1
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  resumeLine: 
  flagsOnEnter:
  - flag: mochi_secreto
    value: 1
  nextNodes:
  - {fileID: -1444277519416856318}
  openingLine: "Florista\u2026 te confieso algo. El cliente de esta noche\u2026 es
    mi madre. Donna Funghi."
  conversationTopics: []
  exitCondition: "El jugador reacciona al secreto (con apoyo, con honestidad, o quit\xE1ndole
    hierro)."
