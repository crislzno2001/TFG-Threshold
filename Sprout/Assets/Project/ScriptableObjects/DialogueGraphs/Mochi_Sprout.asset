  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Mochi_intro
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: 0a1b2c3d-1111-4222-8333-444455556666
  contextForAI: "Estado:\nMochi no conoce al jugador. Est\xE1 sorprendido por ver
    a alguien nuevo en la vieja casita/florister\xEDa. Quiere parecer elegante, pero
    est\xE1 nervioso.\n\nTono:\nEducado, teatral, un poco invasivo, curioso."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  resumeLine: 
  flagsOnEnter:
  - flag: mochi_conocido
    value: 1
  nextNodes:
  - {fileID: 8918418802403930973}
  openingLine: "\u201C\xA1Oh! Espera. Cara nueva. Respiraci\xF3n normal, Mochi, respiraci\xF3n
    normal. T\xFA eres la persona que se ha mudado a la florister\xEDa, \xBFverdad?\u201D "
  conversationTopics: []
  exitCondition: El jugador saluda, se presenta o le pregunta algo a Mochi.
--- !u!114 &-1444277519416856318
