  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Mochi_night_reto
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: 0a1b2c3d-2222-4333-8444-555566667777
  contextForAI: "NOCHE (d\xEDa 2). Mochi est\xE1 m\xE1s calmado, con la m\xE1scara
    medio ca\xEDda tras el servicio. Retoma la idea culinaria que el jugador le dio
    de d\xEDa (la ha estado pensando, aunque finja que no), le se\xF1ala UN defecto
    concreto y le pide que la MEJORE. Comp\xF3rtate seg\xFAn el estado narrativo:
    si player_was_honest=1, m\xE1s abierto y agradecido; si lied_kindly_to_mochi=1,
    medio lo sospecha pero lo agradece; si el jugador evadi\xF3 (mochi_confianza
    no est\xE1), m\xE1s distante e inseguro. NO reveles a\xFAn el secreto de su madre."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  resumeLine: "Anda, has vuelto\u2026 estaba d\xE1ndole vueltas a tu idea, \xBFsabes?"
  flagsOnEnter:
  - flag: mochi_revisado
    value: 1
  nextNodes:
  - {fileID: 4595040912012302065}
  openingLine: "He estado pensando en tu idea. Contra mi voluntad, por supuesto.
    Pero tiene un defecto\u2026 \xBFc\xF3mo lo arreglar\xEDas?"
  conversationTopics: []
  exitCondition: El jugador mejora, ajusta o replantea su idea (no solo la repite
    igual).
--- !u!114 &3387294091708440878
