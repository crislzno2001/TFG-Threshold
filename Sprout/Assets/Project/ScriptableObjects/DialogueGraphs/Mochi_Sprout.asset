  m_Name: Mochi_evade
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 1845133e-9a55-45ad-aaed-166286c614fa
  contextForAI: "El jugador evadi\xF3. Mochi se queda inseguro y algo distante."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  resumeLine: 
  flagsOnEnter: []
  nextNodes:
  - {fileID: 4595040912012302065}
  openingLine: "\xBF\u2026eso es un s\xED o un no? Bah. Da igual. Olv\xEDdalo."
  transitions: []
--- !u!114 &8366287904739317481
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
