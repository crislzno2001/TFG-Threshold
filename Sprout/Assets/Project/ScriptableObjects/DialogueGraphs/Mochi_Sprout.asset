  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Mochi_honest
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 21f3e0d1-f630-4598-bc41-3109e7bc32f2
  contextForAI: Mochi se ofende un segundo pero respeta la honestidad dolorosa. Es
    el camino que de verdad le ayuda.
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: player_was_honest
    value: 1
  nextNodes:
  - {fileID: -328112761125334773}
  openingLine: "\u2026Auch. Duele. Pero\u2026 gracias. Nadie me dice la verdad desde
    hace mucho."
  transitions: []
