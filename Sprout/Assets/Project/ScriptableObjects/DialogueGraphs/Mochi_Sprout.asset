  m_Script: {fileID: 11500000, guid: 511426048eb4ebf46b9184e6496e2b8a, type: 3}
  m_Name: Mochi_taste
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ChoiceNodeSO
  nodeGuid: 501e860d-65e2-4190-8570-cb34ad202ab2
  contextForAI: "Mochi ofrece un risotto experimental amargo y espera elogios. Decisi\xF3n
    clave: mentira amable, honestidad dolorosa, o evasiva."
  prerequisiteFlags:
  - flag: mochi_metida
    expectedValue: 1
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter: []
  nextNodes: []
  openingLine: "Toma. PRU\xC9BALO. Dime que est\xE1 bueno, por favor. \xBF\u2026est\xE1
    bueno?"
  choices:
  - condition: "el jugador dice que est\xE1 delicioso o lo elogia (mentira amable)"
    nextNode: {fileID: -6074387770486369809}
  - condition: "el jugador es honesto y dice que est\xE1 malo, aunque duela"
    nextNode: {fileID: -8674072058029759846}
  - condition: el jugador evade, da una respuesta neutra o no dice nada claro
    nextNode: {fileID: -104039513370049864}
