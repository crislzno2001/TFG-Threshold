  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Mochi_lie
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: d5559e29-b021-4981-9289-9b98886b7288
  contextForAI: "Mochi se cree la mentira amable y gana confianza. M\xE1s tarde puede
    enterarse por cotilleo."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: lied_kindly_to_mochi
    value: 1
  - flag: mochi_confianza
    value: 1
  nextNodes:
  - {fileID: -328112761125334773}
  openingLine: "\xA1LO SAB\xCDA! \xA1Eres un \xE1ngel con tierra en las u\xF1as!
    Mamma mia, qu\xE9 alivio."
  transitions: []
