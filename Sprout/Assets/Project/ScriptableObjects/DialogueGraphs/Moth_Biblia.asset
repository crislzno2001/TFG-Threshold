  nodeGuid: d29f40c6-2481-46d8-99fa-94b9e00b16be
  contextForAI: "Primer encuentro. Moth le dice a la florista que le gusta leer y
    que 'deber\xEDa leer m\xE1s'. Charla ligera sobre libros y el pueblo"
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter: []
  nextNodes:
  - {fileID: 7340065450643523103}
  openingLine: 'Te gusta leer? '
  conversationTopics: []
  exitCondition: El jugador habla de algo que no sea leer
--- !u!114 &-1753252576963257088
MonoBehaviour:
  m_ObjectHideFlags: 0
