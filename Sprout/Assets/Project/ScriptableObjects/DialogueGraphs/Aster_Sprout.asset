  m_Name: Aster_decide
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ChoiceNodeSO
  nodeGuid: 42019f0b-e42c-4581-bb62-8bda73c904ca
  contextForAI: "Decisi\xF3n final que el jugador inclina: encender la m\xE1quina
    de estrellas para reconquistar a la ex, o para s\xED mismo y el pueblo (soltar
    y crecer)."
  prerequisiteFlags:
  - flag: aster_se_da_cuenta
    expectedValue: 1
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter: []
  nextNodes: []
  openingLine: "Entonces\u2026 \xBFla enciendo para ella, a ver si viene? \xBFO la
    enciendo para m\xED, y ya est\xE1?"
  choices:
  - condition: "el jugador le anima a encenderla para s\xED mismo y soltar a su ex"
    nextNode: {fileID: 4513031447080985604}
  - condition: el jugador le anima a intentar reconquistar a su ex
    nextNode: {fileID: 6718700326054769415}
--- !u!114 &1750522520902197565
