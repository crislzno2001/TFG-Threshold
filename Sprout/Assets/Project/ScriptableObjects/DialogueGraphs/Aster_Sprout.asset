  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_bye
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 9837de5f-4867-4fdb-9d55-d34994ce00ee
  contextForAI: Despedida de Aster. Nodo terminal.
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter: []
  nextNodes: []
  openingLine: "Bueno. Me vuelvo al taller. Tengo estrellas que ordenar. Gracias
    por escuchar, en serio. Adi\xF3s, adi\xF3s."
  transitions: []
