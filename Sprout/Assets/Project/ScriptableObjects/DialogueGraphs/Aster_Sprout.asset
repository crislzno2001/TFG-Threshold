  m_Name: Aster_free
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: ff187804-82d5-45e4-a84c-909b39cecbbe
  contextForAI: "Aster decide encenderla para s\xED mismo y el pueblo: ha aprendido
    a soltar. Final de crecimiento."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: aster_libre
    value: 1
  nextNodes:
  - {fileID: 8337667279343445552}
  openingLine: "Para m\xED. Y para quien quiera mirar. \u2026Si ella viene, viene.
    Pero ya no la construyo por eso. Gracias por ayudarme a verlo."
  transitions: []
