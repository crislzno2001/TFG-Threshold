  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_refine
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 364cb1d8-cd34-4c8a-99ff-124ce73668a6
  contextForAI: "El jugador le ayud\xF3 a simplificar con criterio. Aster gana confianza
    y aprende algo."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: aster_idea_mejorada
    value: 1
  nextNodes:
  - {fileID: -3454192694786164522}
  openingLine: "\xBFQuitar\u2026 para que respire? No se me hab\xEDa ocurrido. Menos
    es m\xE1s. Vale. Lo apunto. Gracias, de verdad."
  transitions: []
