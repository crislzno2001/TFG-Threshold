  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_mirror
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: d7fa5d48-647a-430f-b6c6-242a37f1e634
  contextForAI: "El jugador fue honesto: Aster se esconde en la m\xE1quina para no
    enfrentarse a lo de verdad. Le duele pero le toca."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: aster_idea_mejorada
    value: 1
  - flag: player_was_honest
    value: 1
  nextNodes:
  - {fileID: -3454192694786164522}
  openingLine: "\u2026Auch. No me escondo en el invento. Yo no\u2026 vale. Puede.
    Puede que s\xED. No me mires as\xED."
  transitions: []
