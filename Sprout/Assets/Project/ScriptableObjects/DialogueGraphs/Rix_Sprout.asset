  m_Script: {fileID: 11500000, guid: 511426048eb4ebf46b9184e6496e2b8a, type: 3}
  m_Name: Rix_aboutMoth
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ChoiceNodeSO
  nodeGuid: 1c7adffb-0b9f-455e-b0a2-bd691ea7e98b
  contextForAI: "El jugador habla con Rix sobre Moth. Tres ramas seg\xFAn c\xF3mo
    lo plantee."
  prerequisiteFlags:
  - flag: rix_conocido
    expectedValue: 1
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter: []
  nextNodes: []
  openingLine: "\xBFLa polilla? S\xED, la conozco. \xBFPor? \u2026\xBFpor qu\xE9
    me miras as\xED?"
  choices:
  - condition: el jugador habla bien de Moth sin presionar
    nextNode: {fileID: -777625839488206310}
  - condition: el jugador confiesa que Moth trama un plan
    nextNode: {fileID: 948464258596292170}
  - condition: el jugador no menciona a Moth ni nada raro
    nextNode: {fileID: -8892578772104144431}
