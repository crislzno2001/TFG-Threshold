  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Rix_talk
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: cd67f349-c08c-4d5b-8914-9ccf50b8bb1b
  contextForAI: "Rix, rana punk, borde por fuera y sensible por dentro. Dice que
    no le importa nada pero reacciona a todo. No sabe que Moth est\xE1 enamorada
    de \xE9l. Su padre era m\xFAsico y se fue."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: rix_conocido
    value: 1
  nextNodes:
  - {fileID: 8769980681530607060}
  openingLine: "\xBFOtra vez t\xFA? Vale. No me importa. No me importa que no te
    importe que no me importe."
  conversationTopics: []
  exitCondition: El jugador insiste con tacto o le pregunta por su vida.
