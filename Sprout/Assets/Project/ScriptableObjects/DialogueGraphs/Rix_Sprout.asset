  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Rix_neutral
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 9a0ac8f9-6022-4184-b4a2-2b0830d0f70a
  contextForAI: "El jugador no mencion\xF3 nada raro. Rix queda neutro."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: rix_neutral
    value: 1
  nextNodes:
  - {fileID: -7975710103868716029}
  openingLine: "Aj\xE1. Vale. \xBFEso es todo? Pues ya est\xE1."
  transitions: []
--- !u!114 &-7975710103868716029
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
