  m_Name: Rix_curioso
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: c96636cc-4a44-402d-bc29-197a2422e401
  contextForAI: "El jugador despert\xF3 la curiosidad de Rix por Moth, sin presionar."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: rix_curiosidad
    value: 1
  nextNodes:
  - {fileID: -7133825461990086930}
  openingLine: "\xBFEn serio? \u2026no, nada. Solo\u2026 curiosidad. C\xE1llate.
    No he dicho nada."
  transitions: []
