  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Rix_open
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: 405fb156-d79c-42a1-8d1b-a464004f58d8
  contextForAI: "Rix baja la guardia por primera vez y ense\xF1a su cuaderno de canciones.
    Solo ocurre si hubo confianza y NO se le minti\xF3. Reciprocidad: se abre m\xE1s
    si la florista tambi\xE9n se abre."
  prerequisiteFlags:
  - flag: rix_neutral
    expectedValue: 1
  - flag: helped_moth_lie
    expectedValue: 0
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: rix_confia
    value: 1
  nextNodes:
  - {fileID: -7133825461990086930}
  openingLine: "No le digas a nadie que te ense\xF1o esto. \u2026Es un cuaderno.
    De letras. M\xEDas."
  conversationTopics: []
  exitCondition: "El jugador responde con sinceridad, se abre tambi\xE9n, o reacciona
    con frialdad."
