  m_Name: Rix_bye
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: a59a0ccb-1069-4160-89c7-43f2d62387df
  contextForAI: Despedida de Rix. Nodo terminal.
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter: []
  nextNodes: []
  openingLine: "Ya est\xE1 bien de hablar. Vete. \u2026Pero vuelve, \xBFeh. Da igual.
    Lo que quieras."
  transitions: []
