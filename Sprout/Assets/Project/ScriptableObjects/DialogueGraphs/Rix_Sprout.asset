  m_Name: Rix_alerta
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 7e096936-3ab2-4356-a4fa-451059842372
  contextForAI: "El jugador solt\xF3 un plan y puso a Rix en alerta."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: rix_alerta
    value: 1
  nextNodes:
  - {fileID: -7133825461990086930}
  openingLine: "Espera. \xBFT\xFA est\xE1s tramando algo? \xBFPara qui\xE9n trabajas?
    No me f\xEDo."
  transitions: []
