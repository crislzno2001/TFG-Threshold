  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Introduccion_guessing
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 1af5e094-ed06-4f5a-9133-c59fd62d88c0
  contextForAI: "El planeador de semillas de Aster (un aparato que deber\xEDa planear
    y soltar semillas al  caer, y que Aster iba a presentar al concurso de inventos)
    amaneci\xF3 boca abajo en el suelo del taller.Pistas: un ala de tela rajada LIMPIA, 
    como con tijeras, no rota; el dep\xF3sito de semillas VAC\xCDO, y Aster no lo
    vaci\xF3; la puerta  del taller estaba cerrada POR DENTRO. Aster est\xE1 en p\xE1nico
    y no entiende qu\xE9 pas\xF3."
  prerequisiteFlags: []
  lockedReply: 
  resumeLine: 
  flagsOnEnter: []
  nextNodes:
  - {fileID: 7660961428646895183}
  openingLine: No te vas a creer lo que me ha pasado! Mi precioso invento para el
    concurso se ha roto!
  transitions: []
