  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: ConversationNode
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: dc8f0651-b1ca-4d06-a867-2a938eaccc20
  contextForAI: "Primer encuentro ligero. Aster pregunta cu\xE1l es tu invento favorito
    y cu\xE1l es el invento que m\xE1s le joder\xEDa que no existiera. Charla de
    vecinos, sin mencionar a\xFAn el sabotaje ni el planeador roto."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter: []
  nextNodes:
  - {fileID: 5171034301682998171}
  openingLine: "\xBFCu\xE1l es tu invento favorito? Y m\xE1s importante: \xBFcu\xE1l
    te joder\xEDa much\xEDsimo que no hubieran inventado nunca?"
  conversationTopics: []
  exitCondition: "El jugador ha respondido a al menos una de las dos preguntas (o
    corta la conversaci\xF3n)"
--- !u!114 &5407999468533157865
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
