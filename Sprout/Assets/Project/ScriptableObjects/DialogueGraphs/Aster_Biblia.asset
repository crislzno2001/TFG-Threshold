  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 83fe9b9c-c469-45dc-879f-bf9071813fde
  contextForAI: "El jugador ignor\xF3 la confesi\xF3n o fue fr\xEDo/cruel. Aster
    se cierra y vuelve al invento para protegerse. Dolido pero disimulando."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
