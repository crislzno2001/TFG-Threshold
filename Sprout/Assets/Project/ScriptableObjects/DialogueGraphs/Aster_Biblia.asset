  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_mirror
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 581a21f0-5d64-4966-bd40-510e7f6fca2f
  contextForAI: 'El jugador fue honesto: Aster se esconde en el invento para no enfrentarse
    a lo de verdad. Le duele pero le toca.'
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_idea_mejorada
    value: 1
  - flag: player_was_honest
    value: 1
  nextNodes:
  - {fileID: -1186919018910481802}
  openingLine: "\u2026Auch. No me escondo en el invento. Yo no\u2026 vale. Puede.
    Puede que s\xED. No me mires as\xED."
  transitions: []
