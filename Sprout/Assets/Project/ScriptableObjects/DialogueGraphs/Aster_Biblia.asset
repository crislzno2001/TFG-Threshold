  m_Script: {fileID: 11500000, guid: 511426048eb4ebf46b9184e6496e2b8a, type: 3}
  m_Name: Aster_decide
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ChoiceNodeSO
  nodeGuid: b0433615-2c96-4894-a232-cc4a502a017a
  contextForAI: "Decisi\xF3n final que el jugador inclina: encender la m\xE1quina
    para la ex (a ver si viene), o para s\xED mismo y soltar."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter: []
  nextNodes: []
  openingLine: "Entonces\u2026 \xBFla enciendo para ella, a ver si viene? \xBFO la
    enciendo para m\xED, y ya est\xE1?"
  choices:
  - condition: "le anima a encenderla para s\xED mismo y soltar a su ex"
    nextNode: {fileID: -6298581324874706954}
  - condition: le anima a intentar reconquistar a su ex
    nextNode: {fileID: -3421547741519525877}
