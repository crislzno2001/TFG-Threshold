  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Aster_challenge_product_improvement
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: 0de76f03-4657-4420-a4f9-8e4e2c6d0421
  contextForAI: "Aster ha estado pensando que igual que se haya roto su invento es
    una oportunidad para hacer algo mejor y era una se\xF1al de que no era lo bastante
    bueno para el concurso. "
  prerequisiteFlags: []
  lockedReply: 
  resumeLine: "Sigo pensando en como mejorar mi invento, \xA1y me quedo sin tiempo!
    Ayudame"
  flagsOnEnter:
  - flag: 
    value: 1
  nextNodes:
  - {fileID: -2480416435457040514}
  openingLine: "He estado pensando... y no hay mal que por bien no venga. Ya que
    lo abro entero para arreglarlo\u2026 \xBFc\xF3mo lo dejar\xEDas, mejor que antes?"
  conversationTopics:
  - el invento
  - el concurso
  - ideas para emocionar
  exitCondition: El jugador propone una idea concreta
--- !u!114 &7660961428646895183
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: ASTER_GuessingCuases
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: c6c6cafc-0f05-4b2c-995d-82cbd4f7874b
  contextForAI: "El planeador de semillas de Aster (un aparato que deber\xEDa planear
    y soltar semillas al  caer, y que Aster iba a presentar al concurso de inventos)
    amaneci\xF3 boca abajo en el suelo del taller.Pistas: un ala de tela rajada LIMPIA, 
    como con tijeras, no rota; el dep\xF3sito de semillas VAC\xCDO, y Aster no lo
    vaci\xF3; la puerta  del taller estaba cerrada POR DENTRO. Aster est\xE1 en p\xE1nico
    y no entiende qu\xE9 pas\xF3.El concurso es para aumentar la sostenebilidad del
    pueblo y mejorar la vida de los habitantes y aster no sabe cu\xE1l es el premio
    pero espera que sea unas placas solares. El jugador le dar\xE1 ideas de qu\xE9
    ha podido pasar o le preguntar\xE1 por el concurso o por m\xE1s detalles del
    incidente. Aster responder\xE1 muy nervioso y le dar\xE1 motivos por los cuales
    si habria podido pasar eso o no para estimular mas ideas."
  prerequisiteFlags: []
  lockedReply: 
  resumeLine: "\xBFDonde estabas? A\xFAn no hemos resuelto el CRIMEN"
  flagsOnEnter:
  - flag: aster_sabotaje_sospecha
    value: 1
  nextNodes:
  - {fileID: -1761130981045325502}
  openingLine: "Mi planeador est\xE1 en el suelo, un ala cortada limpia y el dep\xF3sito
    vac\xEDo\u2026 y la puerta estaba cerrada por dentro. No lo entiendo. \xBFPor
    qu\xE9 crees que ha pasado? Dame teor\xEDas, TODAS, por locas que sean."
  conversationTopics:
  - el invento
  - el concurso
  - el incidente
  exitCondition: "Cuando el jugador deje de dar ideas de que ha podido pasar, cuando
    no pregunte mas por el concurso o el invento o cuando diga que ya est\xE1 bien
    o se despida."
