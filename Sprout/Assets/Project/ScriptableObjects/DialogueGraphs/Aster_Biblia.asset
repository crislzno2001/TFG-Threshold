  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_grudge
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 1f49ae62-6f62-45d2-b36a-ff769e7266f4
  contextForAI: "El jugador lo neg\xF3 o culp\xF3 a Mochi. Aster se enfada m\xE1s
    y se cierra, fr\xEDo y defensivo."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_angry
    value: 1
  nextNodes:
  - {fileID: 86409384787902630}
  openingLine: "Vale. Entonces, adem\xE1s de hablar, tambi\xE9n desaparecen palabras
    de tu boca por arte de magia. Fascinante. D\xE9jame con mis estrellas."
  transitions: []
