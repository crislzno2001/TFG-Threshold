  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Aster_meet
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: 18880413-4dc9-434d-8ab9-9aea07070b6e
  contextForAI: "PRIMER ENCUENTRO (ma\xF1ana). Aster, conejo cient\xEDfico t\xEDmido
    y nervioso, ve por primera vez a la florista reci\xE9n mudada; no se conocen
    de nada. Se presenta atropellado, se contradice, suelta alg\xFAn dato absurdo
    para llenar silencios.  "
  prerequisiteFlags: []
  lockedReply: 
  resumeLine: 
  flagsOnEnter:
  - flag: aster_met
    value: 1
  nextNodes:
  - {fileID: 5172476293423151946}
  openingLine: "Hola, perdona\u2026 \xBFt\xFA eres quien se ha mudado? Yo soy Aster.
    Encantado. Perdona, no esperaba cara nueva hoy. \xBFHa sido raro esto? Un poco
    raro."
  conversationTopics:
  - presentarse
  - el pueblo
  - "la florister\xEDa"
  exitCondition: El jugador le dice algo que no sea presentarse.
--- !u!114 &-5129340733885152794
MonoBehaviour:
  m_ObjectHideFlags: 0
