  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_insist
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 03fe3770-ec64-4123-8ba9-32b780ae05ae
  contextForAI: Aster decide encenderla para reconquistar a la ex. Puede salir bien
    o doler.
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_insiste
    value: 1
  nextNodes:
  - {fileID: 86409384787902630}
  openingLine: "Para ella. Tengo que intentarlo. Si no, me preguntar\xE9 siempre\u2026
    \xBFy si hubiera funcionado?"
  transitions: []
--- !u!114 &-2210879052678133248
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
