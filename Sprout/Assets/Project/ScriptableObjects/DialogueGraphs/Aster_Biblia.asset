  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_bye_am
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 833ccaca-098f-4510-b3db-f135fa88952f
  contextForAI: "Fin del primer encuentro de la ma\xF1ana. Se despide nervioso y
    majo, sin mencionar a\xFAn su invento. Terminal."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: glow_aster_none
    value: 1
  nextNodes: []
  openingLine: "Bueno\u2026 un placer, vecina. Me vuelvo a lo m\xEDo antes de que
    se me olvide. Adi\xF3s, adi\xF3s."
  transitions: []
--- !u!114 &3655288832653200241
MonoBehaviour:
  m_ObjectHideFlags: 0
