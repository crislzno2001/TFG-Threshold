  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_refine
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 6d1e0939-e265-412e-815d-99f54ae147f8
  contextForAI: "El jugador le ayud\xF3 a SIMPLIFICAR con criterio. Aster gana confianza
    y aprende algo."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_idea_mejorada
    value: 1
  - flag: player_helped_aster_good
    value: 1
  nextNodes:
  - {fileID: -1186919018910481802}
  openingLine: "\xBFQuitar\u2026 para que respire? No se me hab\xEDa ocurrido. Menos
    es m\xE1s. Gracias, de verdad."
  transitions: []
--- !u!114 &-3421547741519525877
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
