  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_bye
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: e011feb9-1b5c-4f2e-a4f4-917cc0c7dbe3
  contextForAI: "Despedida final del d\xEDa. Antes de irse te sugiere hablar con
    Moth sobre la luz. Terminal."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: recommend_moth
    value: 1
  - flag: glow_aster_none
    value: 1
  nextNodes: []
  openingLine: "Me vuelvo al taller. Oye\u2026 preg\xFAntale a Moth sobre la luz.
    Habla como si desayunara imposibles. Gracias por escuchar."
  transitions: []
--- !u!114 &321616645109206622
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_forgive
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: afe75e19-deff-423d-aca7-d8c3d3c8afd5
  contextForAI: "El jugador admiti\xF3 y se disculp\xF3. Aster no lo pone f\xE1cil,
    pero puede perdonar. Sigue dolido, pero valora la honestidad."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_forgives
    value: 1
  - flag: glow_aster_none
    value: 1
  nextNodes:
  - {fileID: 86409384787902630}
  openingLine: "Gracias por no mentir. No arregla la grieta, pero al menos no le
    has puesto pintura encima. La pr\xF3xima vez, preg\xFAntame antes de convertirme
    en noticia."
  transitions: []
--- !u!114 &331902338726115905
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Aster_challenge
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: 0de76f03-4657-4420-a4f9-8e4e2c6d0421
  contextForAI: "MEDIOD\xCDA. Aster ense\xF1a su m\xE1quina de estrellas: proyecta
    el cielo de una noche concreta, pero se ve plano y sin emoci\xF3n. Pide IDEAS
    para que EVOQUE un recuerdo (un sonido, un olor, una estrella fugaz en el momento
    justo, que reaccione a quien mira\u2026). Mide ORIGINALIDAD. Reacciona con drama:
    si es rara y buena se entusiasma; si es vaga la pincha; si es cruel se duele.
    A\xDAN no dice para qui\xE9n es."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_metido
    value: 1
  nextNodes:
  - {fileID: -2210879052678133248}
  openingLine: "He construido una m\xE1quina que proyecta el cielo de una noche concreta.
    Pero est\xE1\u2026 muerto. No parece aquella noche. \xBFC\xF3mo hago que EMOCIONE?
    Dime ideas, por raras que sean."
  conversationTopics:
  - el invento
  - el concurso
  - ideas para emocionar
  exitCondition: El jugador propone al menos una idea concreta.
--- !u!114 &999368403964384811
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
