  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 634db20e-367a-4d1a-a60f-768ae5b54a8f
  contextForAI: Despedida de Moth. Nodo terminal.
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter: []
  nextNodes: []
  openingLine: "Vuelve ma\xF1ana. La luz cambia de noche. Yo tambi\xE9n. No te vayas
    t\xFA tambi\xE9n."
  transitions: []
