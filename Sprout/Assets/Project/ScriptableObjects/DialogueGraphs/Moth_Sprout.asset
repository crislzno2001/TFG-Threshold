  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Moth_talk
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: 28809cb5-e019-41cd-a9e8-315a4f532c84
  contextForAI: "Moth, polilla obsesiva y metaf\xF3rica. Habla en met\xE1foras raras,
    observa demasiado, dice cosas que no deber\xEDa. Est\xE1 obsesionada con Rix
    pero lo disfraza de inter\xE9s filos\xF3fico."
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: moth_conocida
    value: 1
  nextNodes:
  - {fileID: 4372214877672487808}
  openingLine: "La luz no se mira. Se siente. T\xFA tienes una luz\u2026 pr\xE1ctica.
    Me gusta."
  conversationTopics: []
  exitCondition: "El jugador le sigue la conversaci\xF3n o le pregunta qu\xE9 quiere."
