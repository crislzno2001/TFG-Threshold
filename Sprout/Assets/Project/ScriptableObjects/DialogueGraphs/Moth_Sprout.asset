  m_Name: Moth_poem
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: 700a6af5-9371-4596-b1b3-1209724e7e63
  contextForAI: "NODO DE ELABORACI\xD3N: Moth pide ayuda para escribir un poema para
    Rix. Aqu\xED se mide Elaboraci\xF3n (si el jugador da detalles concretos o va
    seco)."
  prerequisiteFlags:
  - flag: moth_conocida
    expectedValue: 1
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter: []
  nextNodes:
  - {fileID: 8384139551066877730}
  openingLine: "\xBFMe ayudas con unas palabras? Para\u2026 un amigo. Tienen que
    sonar a verdad aunque no lo sean."
  conversationTopics: []
  exitCondition: El jugador aporta una estrofa, una imagen concreta, o dice que no
    se le ocurre nada.
