  m_Script: {fileID: 11500000, guid: 9fa257dd4a8dea3479ec1e976e8b10ec, type: 3}
  m_Name: Moth_confess
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ConversationNodeSO
  nodeGuid: d207512e-5fb5-4663-bfc7-204a8bf2502e
  contextForAI: "Moth confiesa su obsesi\xF3n con Rix y pide a la florista que medie.
    Empieza a depender emocionalmente."
  prerequisiteFlags:
  - flag: moth_conocida
    expectedValue: 1
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: moth_pidio_ayuda
    value: 1
  nextNodes:
  - {fileID: -2309065594898298876}
  openingLine: "Vale. No es para un amigo. Es para Rix. Lo necesito. \xBFMe ayudas
    a que me vea?"
  conversationTopics: []
  exitCondition: "El jugador acepta ayudar, duda, o le pone l\xEDmites."
