  m_Name: Moth_helped
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 63a913fa-27f2-41e6-9107-ba9395617566
  contextForAI: El jugador acepta la mentira. Esto puede estallar cuando Rix lo descubra.
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: helped_moth_lie
    value: 1
  nextNodes:
  - {fileID: 6461630656984719229}
  openingLine: "\xBFLo har\xE1s? Gracias. Gracias. Sab\xEDa que t\xFA s\xED sent\xEDas
    mi luz."
  transitions: []
--- !u!114 &2653171959398314921
MonoBehaviour:
  m_ObjectHideFlags: 0
