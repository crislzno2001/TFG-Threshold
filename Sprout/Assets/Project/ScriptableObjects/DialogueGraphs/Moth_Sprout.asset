  m_Name: Moth_refused
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 9d0feadd-e6f8-474b-982c-732b77069de4
  contextForAI: El jugador se niega a la mentira (honestidad). Moth se duele pero
    lo encaja.
  prerequisiteFlags: []
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter:
  - flag: player_was_honest
    value: 1
  nextNodes:
  - {fileID: 6461630656984719229}
  openingLine: "\u2026Claro. Tienes raz\xF3n. Perdona. Es que\u2026 no quiero que
    se apague antes de encenderse."
  transitions: []
