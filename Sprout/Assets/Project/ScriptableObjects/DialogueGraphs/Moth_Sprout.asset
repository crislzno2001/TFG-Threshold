  m_Script: {fileID: 11500000, guid: 511426048eb4ebf46b9184e6496e2b8a, type: 3}
  m_Name: Moth_request
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ChoiceNodeSO
  nodeGuid: 84323570-89e3-4e40-b086-2de5474375f8
  contextForAI: "Petici\xF3n turbia: Moth pide inventarle a Rix algo que ella no
    hizo. Decisi\xF3n moral del juego."
  prerequisiteFlags:
  - flag: moth_pidio_ayuda
    expectedValue: 1
  lockedReply: "A\xFAn no puedes avanzar por aqu\xED."
  flagsOnEnter: []
  nextNodes: []
  openingLine: "Dile a Rix que escrib\xED una canci\xF3n para \xE9l. No es verdad,
    pero\u2026 funciona mejor si no lo es."
  choices:
  - condition: el jugador acepta inventarle la mentira a Rix
    nextNode: {fileID: 2003639617293267540}
  - condition: "el jugador se niega a mentir y le pone l\xEDmites con cari\xF1o"
    nextNode: {fileID: -8904186055231509168}
