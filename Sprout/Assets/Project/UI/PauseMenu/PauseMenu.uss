.pause-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.pause-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.75);
}

.pause-panel {
    width: 460px;
    padding: 40px;
    background-color: rgba(15, 20, 28, 0.95);
    border-width: 1px;
    border-color: rgb(60, 75, 95);
    border-radius: 4px;
    align-items: center;
}

.pause-title {
    font-size: 42px;
    color: rgb(220, 230, 240);
    -unity-font-style: bold;
    letter-spacing: 12px;
    margin-bottom: 36px;
}

.pause-buttons {
    width: 100%;
    align-items: stretch;
}

.pause-button {
    height: 48px;
    margin: 5px 0;
    background-color: rgba(20, 25, 35, 0.85);
    border-width: 1px;
    border-color: rgb(60, 75, 95);
    color: rgb(200, 210, 220);
    font-size: 16px;
    letter-spacing: 2px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
    border-radius: 2px;
}

.pause-button:hover {
    background-color: rgba(40, 60, 90, 0.95);
    border-color: rgb(140, 180, 220);
    color: rgb(240, 250, 255);
    scale: 1.02 1.02;
}

.pause-button:active {
    background-color: rgba(70, 100, 140, 1);
    scale: 0.98 0.98;
}
