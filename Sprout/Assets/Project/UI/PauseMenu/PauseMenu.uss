.pause-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.pause-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(46, 40, 38, 0.55);
}

.pause-panel {
    width: 420px;
    padding: 40px;
    background-color: rgb(247, 242, 230);
    border-width: 2px;
    border-color: rgb(124, 169, 130);
    border-radius: 26px;
    align-items: center;
}

.pause-title {
    font-size: 40px;
    color: rgb(86, 125, 92);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 28px;
}

.pause-buttons {
    width: 100%;
    align-items: stretch;
}

.pause-button {
    height: 52px;
    margin: 6px 0;
    background-color: rgb(255, 251, 243);
    border-width: 2px;
    border-color: rgb(124, 169, 130);
    color: rgb(74, 62, 54);
    font-size: 16px;
    letter-spacing: 1px;
    transition-property: background-color, border-color, scale, color;
    transition-duration: 0.12s;
    border-radius: 14px;
}

.pause-button:hover {
    background-color: rgb(124, 169, 130);
    border-color: rgb(86, 125, 92);
    color: rgb(255, 252, 245);
    scale: 1.03 1.03;
}

.pause-button:active {
    background-color: rgb(86, 125, 92);
    scale: 0.97 0.97;
}
