<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/UI/PauseMenu/PauseMenu.uss?fileID=7433441132597879392&amp;guid=38e13d315fcd28b438a321d0c07a886b&amp;type=3#PauseMenu" />
    <ui:VisualElement name="root" class="pause-root">
        <ui:VisualElement name="overlay" class="pause-overlay" />

        <ui:VisualElement name="panel" class="pause-panel">
            <ui:Label name="title" text="PAUSA" class="pause-title" />

            <ui:VisualElement name="buttons" class="pause-buttons">
                <ui:Button name="btn-resume"     text="Reanudar"            class="pause-button" />
                <ui:Button name="btn-save"       text="Guardar"             class="pause-button" />
                <ui:Button name="btn-settings"   text="Configuración"       class="pause-button" />
                <ui:Button name="btn-main-menu"  text="Salir al menú principal" class="pause-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
