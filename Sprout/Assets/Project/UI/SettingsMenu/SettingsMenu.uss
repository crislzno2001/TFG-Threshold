.settings-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.settings-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.75);
}

.settings-panel {
    width: 600px;
    padding: 40px;
    background-color: rgba(15, 20, 28, 0.95);
    border-width: 1px;
    border-color: rgb(60, 75, 95);
    border-radius: 4px;
}

.settings-title {
    font-size: 36px;
    color: rgb(220, 230, 240);
    -unity-font-style: bold;
    letter-spacing: 10px;
    margin-bottom: 30px;
    -unity-text-align: middle-center;
}

.settings-rows {
    width: 100%;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    margin: 8px 0;
}

.settings-label {
    width: 160px;
    color: rgb(180, 200, 220);
    font-size: 14px;
    letter-spacing: 1px;
}

.settings-slider {
    flex-grow: 1;
    margin: 0 12px;
}

.settings-value {
    width: 60px;
    color: rgb(200, 210, 220);
    font-size: 14px;
    -unity-text-align: middle-right;
}

.settings-buttons {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 24px;
}

.settings-button {
    flex-grow: 1;
    height: 44px;
    margin: 0 5px;
    background-color: rgba(20, 25, 35, 0.85);
    border-width: 1px;
    border-color: rgb(60, 75, 95);
    color: rgb(200, 210, 220);
    font-size: 15px;
    letter-spacing: 2px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
    border-radius: 2px;
}

.settings-button:hover {
    background-color: rgba(40, 60, 90, 0.95);
    border-color: rgb(140, 180, 220);
    color: rgb(240, 250, 255);
    scale: 1.02 1.02;
}

.settings-button:active {
    background-color: rgba(70, 100, 140, 1);
    scale: 0.98 0.98;
}
