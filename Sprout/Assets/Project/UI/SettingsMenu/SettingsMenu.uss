.settings-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.settings-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    /* Fondo OPACO: tapa por completo la escena (antes era semitransparente y se veía todo). */
    background-color: rgb(224, 235, 214);
    /* --- Estampado de hojas (cuando tengas el PNG de Gemini, descomenta estas 3 líneas) --- */
    /* background-image: url("project://database/Assets/Project/UI/SettingsMenu/leaves_pattern.png"); */
    /* background-repeat: repeat; */
    /* background-size: 256px 256px; */
}

.settings-panel {
    width: 720px;
    padding: 46px;
    background-color: rgb(247, 242, 231);
    border-width: 3px;
    border-color: rgb(214, 203, 180);
    border-radius: 32px;
}

.settings-title {
    font-size: 40px;
    color: rgb(86, 125, 92);
    -unity-font-style: bold;
    margin-bottom: 34px;
    -unity-text-align: middle-center;
}

.settings-rows {
    width: 100%;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    margin-top: 7px;
    margin-bottom: 7px;
}

.settings-label {
    width: 170px;
    color: rgb(74, 64, 54);
    font-size: 15px;
}

.settings-slider {
    flex-grow: 1;
    margin-left: 12px;
    margin-right: 12px;
}

.settings-value {
    width: 56px;
    color: rgb(124, 110, 92);
    font-size: 14px;
    -unity-text-align: middle-right;
}

.settings-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 28px;
}

.settings-button {
    flex-grow: 1;
    height: 44px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgb(255, 251, 243);
    border-width: 2px;
    border-color: rgb(124, 169, 130);
    color: rgb(86, 125, 92);
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 14px;
    transition-property: background-color, color, scale;
    transition-duration: 0.15s;
}

.settings-button:hover {
    background-color: rgb(124, 169, 130);
    color: rgb(255, 255, 255);
    scale: 1.02 1.02;
}

.settings-button:active {
    scale: 0.98 0.98;
}
