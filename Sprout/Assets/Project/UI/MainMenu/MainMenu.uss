.root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(243, 237, 223);
}

.background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(124, 169, 130, 0.12);
}

.content {
    align-items: center;
    justify-content: center;
    width: 460px;
    padding: 40px;
}

.title {
    font-size: 80px;
    color: rgb(86, 125, 92);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.subtitle {
    font-size: 16px;
    color: rgb(150, 132, 112);
    letter-spacing: 3px;
    margin-bottom: 54px;
}

.buttons {
    width: 100%;
    align-items: stretch;
}

.menu-button {
    height: 56px;
    margin: 7px 0;
    background-color: rgb(255, 251, 243);
    border-width: 2px;
    border-color: rgb(124, 169, 130);
    color: rgb(74, 62, 54);
    font-size: 18px;
    letter-spacing: 1px;
    transition-property: background-color, border-color, scale, color;
    transition-duration: 0.12s;
    border-radius: 16px;
}

.menu-button:hover {
    background-color: rgb(124, 169, 130);
    border-color: rgb(86, 125, 92);
    color: rgb(255, 252, 245);
    scale: 1.03 1.03;
}

.menu-button:active {
    background-color: rgb(86, 125, 92);
    scale: 0.97 0.97;
}

.menu-button--disabled {
    opacity: 0.4;
}
