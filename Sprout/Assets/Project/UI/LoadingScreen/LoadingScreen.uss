.loading-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(243, 237, 223);
}

.loading-content {
    align-items: center;
    width: 500px;
}

.loading-title {
    font-size: 30px;
    color: rgb(86, 125, 92);
    letter-spacing: 6px;
    -unity-font-style: bold;
    margin-bottom: 28px;
}

.progress-track {
    width: 100%;
    height: 12px;
    background-color: rgb(226, 217, 197);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(199, 187, 162);
    overflow: hidden;
}

.progress-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(124, 169, 130);
    border-radius: 6px;
    transition-property: width;
    transition-duration: 0.15s;
}

.loading-percentage {
    margin-top: 14px;
    font-size: 15px;
    color: rgb(150, 132, 112);
    letter-spacing: 3px;
}
