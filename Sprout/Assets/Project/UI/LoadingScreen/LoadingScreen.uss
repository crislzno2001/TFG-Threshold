.loading-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;   /* título + barra abajo, para que se vea el paisaje */
    background-color: rgb(243, 237, 223);
}

/* ── Capas de parallax (se repiten en horizontal y las mueve ParallaxScroller) ── */
.layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-repeat: repeat-x;        /* repite solo en horizontal (clave del bucle) */
    background-position-x: left;
    background-position-y: bottom;      /* ancla el paisaje ABAJO (no centrado) */
}
/* El cielo llena toda la pantalla y va detrás de todo */
.sky {
    background-image: url("project://database/Assets/Project/UI/LoadingScreen/sky2.png");
    background-repeat: repeat;
    background-position-y: top;
    background-size: cover;
}
/* Altura de cada franja (ancho auto = mantiene proporción). Retoca estos % a tu gusto. */
.mountains {
    background-image: url("project://database/Assets/Project/UI/LoadingScreen/mountains.png");
    background-size: auto 55%;
}
.trees {
    background-image: url("project://database/Assets/Project/UI/LoadingScreen/trees.png");
    background-size: auto 42%;
}
.ground {
    background-image: url("project://database/Assets/Project/UI/LoadingScreen/ground.png");
    background-size: auto 34%;
}

.loading-content {
    align-items: center;
    width: 420px;
    margin-bottom: 42px;         /* separación del borde inferior */
    padding: 22px 30px;          /* aire dentro del panel */
    background-color: rgba(247, 242, 231, 0.82);  /* crema semitransparente */
    border-width: 2px;
    border-color: rgba(199, 187, 162, 0.9);
    border-radius: 22px;         /* bordes redondeados */
}

.loading-title {
    font-size: 30px;
    color: rgb(86, 125, 92);
    letter-spacing: 6px;
    -unity-font-style: bold;
    margin-bottom: 28px;
}

.progress-track {
    width: 100%;
    height: 12px;
    background-color: rgb(226, 217, 197);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(199, 187, 162);
    overflow: hidden;
}

.progress-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(124, 169, 130);
    border-radius: 6px;
    transition-property: width;
    transition-duration: 0.15s;
}

.loading-percentage {
    margin-top: 14px;
    font-size: 15px;
    color: rgb(150, 132, 112);
    letter-spacing: 3px;
}
