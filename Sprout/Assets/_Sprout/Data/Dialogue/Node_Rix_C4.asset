  nodeGuid: 
  contextForAI: "Hablar a Rix sobre Moth. Reacciona seg\xFAn si el jugador la menciona
    con cari\xF1o, confiesa el plan, o evita el tema. Responde siempre en espa\xF1ol."
  prerequisiteFlags:
  - flag: rix_known
    expectedValue: 1
  lockedReply: "...\xBFEh? No s\xE9 de qu\xE9 hablas."
  flagsOnEnter: []
  nextNodes: []
  openingLine: "\xBFMoth? Esa polilla rara. \xBFQu\xE9 pasa con Moth?"
  transitions:
  - condition: "el jugador menciona a Moth con cari\xF1o, sin revelar ning\xFAn plan"
    targetNode: {fileID: 11400000, guid: 524a81f66d984d34e8baca73b229b7e5, type: 2}
  - condition: el jugador confiesa el plan o el mensaje falso de Moth
