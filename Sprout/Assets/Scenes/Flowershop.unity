  m_Script: {fileID: 11500000, guid: 2f0940864fd6bb049866db213fd4c9d9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sprout.Presentation.LetterPopup
  paper: {fileID: 2800000, guid: 54581063c86dec645ac4ca87f991d5eb, type: 3}
  letterText: "Mi querid\xEDsima florecita:\r\n\r\nSi est\xE1s leyendo esto, es que
    por fin has llegado. S\xE9 que la ciudad te\r\napretaba el pecho; yo tambi\xE9n
    fui joven y tambi\xE9n hui hacia un lugar\r\npeque\xF1o donde el tiempo va m\xE1s
    despacio.\r\n\r\nEsta florister\xEDa fue mi vida entera. Cada rinc\xF3n guarda
    una conversaci\xF3n,\r\nuna despedida, un \"gracias\" que alguien dijo con flores
    porque no supo\r\ndecirlo con palabras.\r\n\r\nAhora es tuya. No te pido que
    la cuides como yo \u2014 te pido que la hagas\r\ntuya. Escucha a los vecinos,
    aunque digan cosas raras: detr\xE1s de cada uno\r\nhay una flor esperando a brotar.\r\n\r\nTe
    quiero m\xE1s de lo que estas l\xEDneas pueden sostener.\r\n\r\nLa abuela."
  textColor: {r: 0, g: 0, b: 0, a: 1}
  fontSize: 16
  revealSpeed: 45
  paperWidth: 1000
  paperHeight: 600
  textInsetPct: {x: 0.32, y: 0.2, z: 0.2, w: 0.1}
  key: 2
  lockPlayer: 1
  playerTag: Player
  hideOnFinish: {fileID: 718754992}
  onFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1055698612}
