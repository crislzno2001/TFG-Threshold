--- !u!114 &3561034632549828475
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 511426048eb4ebf46b9184e6496e2b8a, type: 3}
  m_Name: Aster_gossip
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ChoiceNodeSO
  nodeGuid: 04b33c2e-0e19-4291-9a1a-fefd3b083c4a
  contextForAI: "Aster sabe que la florista le cont\xF3 a Mochi lo de su ex. Herido
    pero fingiendo frialdad, confronta: \xBFse lo contaste t\xFA? Seg\xFAn responda,
    perdona o se cierra."
  prerequisiteFlags:
  - flag: aster_angry
    expectedValue: 1
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_sabe_que_cotilleaste
    value: 1
  nextNodes: []
  openingLine: "Mochi me ha preguntado por mi ex. Con esa voz de 'yo no s\xE9 nada',
    que es justo la voz de quien sabe algo. \u2026\xBFSe lo contaste t\xFA?"
  choices:
  - condition: el jugador lo admite y se disculpa con sinceridad
    nextNode: {fileID: 7842217028166960096}
  - condition: el jugador lo niega, culpa a Mochi o se burla
    nextNode: {fileID: -3447965769781748127}
--- !u!114 &4378511989687501086
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_free
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 5eb4df3b-7ffe-4bdc-bae6-09e78a33e229
  contextForAI: "Aster decide encender la m\xE1quina para s\xED mismo y el pueblo:
    aprende a soltar. Final de crecimiento."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_libre
    value: 1
  nextNodes:
  - {fileID: 5691390254844099713}
  openingLine: "Para m\xED. Y para quien quiera mirar. Si ella viene, viene. Pero
    ya no la construyo por eso. Gracias por ayudarme a verlo."
  transitions: []
