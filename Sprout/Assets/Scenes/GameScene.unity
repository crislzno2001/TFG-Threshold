--- !u!114 &993751090778018318
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 511426048eb4ebf46b9184e6496e2b8a, type: 3}
  m_Name: Aster_attempt
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ChoiceNodeSO
  nodeGuid: 15265c1a-0bc2-41ae-afb8-fafdee556dbb
  contextForAI: "TARDE. Aster ense\xF1a un intento saturado de estrellas (una bombilla
    que ciega). Momento vulnerable. Decisi\xF3n: ayudarle a simplificar con criterio,
    o decirle con honestidad que se esconde en el invento."
  prerequisiteFlags:
  - flag: aster_met
    expectedValue: 1
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter: []
  nextNodes: []
  openingLine: "Yo ya prob\xE9 algo\u2026 le met\xED TODAS las estrellas que pude.
    Ahora en vez de un cielo es una bombilla que ciega. Me he pasado, \xBFverdad?"
  choices:
  - condition: el jugador le ayuda a simplificar con criterio
    nextNode: {fileID: -4310401074370485196}
  - condition: el jugador le dice con honestidad que se esconde en el invento
    nextNode: {fileID: -802924246876509574}
--- !u!114 &1024048882807877712
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 511426048eb4ebf46b9184e6496e2b8a, type: 3}
  m_Name: Aster_react
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ChoiceNodeSO
  nodeGuid: 82bbc7d6-14c7-4d8c-8234-c6355e44e69d
  contextForAI: "Aster acaba de confesar que la m\xE1quina es para su ex y espera
    una reacci\xF3n, expuesto."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter: []
  nextNodes: []
  openingLine: "\u2026Ya est\xE1. Lo he dicho. Di algo. Lo que sea. Tu cara me est\xE1
    poniendo nervioso."
  choices:
  - condition: "el jugador responde con empat\xEDa y tacto"
    nextNode: {fileID: -8420217992462988677}
  - condition: "el jugador ignora la confesi\xF3n, es fr\xEDo, cruel o reacciona
      demasiado"
    nextNode: {fileID: 53501542043839701}
