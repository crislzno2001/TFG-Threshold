  m_Script: {fileID: 11500000, guid: 2d7ea96990569a846933746bfee7caea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sprout.Presentation.VillageIntroTour
  playerTag: Player
  player: {fileID: 514480678892743149}
  stops:
  - text: "\xA1Bienvenida a tu nuevo pueblo! Aqu\xED empieza tu historia."
    target: {fileID: 514480678892743149}
    returnToPlayerAfter: 0
  - text: "Esa de ah\xED es tu casa. Por la noche, duerme en la cama para guardar
      y empezar un d\xEDa nuevo."
    target: {fileID: 73705174}
    returnToPlayerAfter: 1
  - text: Si quieres guardar la partida antes de la noche, pulsa ESC para abrir el
      menu de pausa.
    target: {fileID: 0}
    returnToPlayerAfter: 0
  - text: "Esta es tu florister\xEDa, el negocio que te dej\xF3 la abuela. Aqu\xED
      preparar\xE1s ramos."
    target: {fileID: 2020102913}
    returnToPlayerAfter: 1
  - text: "Ac\xE9rcate a tus vecinos y pulsa E para presentarte. \xA1Esc\xFAchalos
      bien!"
    target: {fileID: 189986774}
    returnToPlayerAfter: 1
  viewYaw: 0
  pitch: 28
  distance: 12
  lookHeight: 1.4
  moveDuration: 2.2
