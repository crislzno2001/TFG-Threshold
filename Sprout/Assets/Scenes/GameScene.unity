%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &-8420217992462988677
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 511426048eb4ebf46b9184e6496e2b8a, type: 3}
  m_Name: Aster_decide
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ChoiceNodeSO
  nodeGuid: b0433615-2c96-4894-a232-cc4a502a017a
  contextForAI: "Decisi\xF3n final que el jugador inclina: encender la m\xE1quina
    para la ex (a ver si viene), o para s\xED mismo y soltar."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter: []
  nextNodes: []
  openingLine: "Entonces\u2026 \xBFla enciendo para ella, a ver si viene? \xBFO la
    enciendo para m\xED, y ya est\xE1?"
  choices:
  - condition: "le anima a encenderla para s\xED mismo y soltar a su ex"
    nextNode: {fileID: 4378511989687501086}
  - condition: le anima a intentar reconquistar a su ex
    nextNode: {fileID: 501308832602398993}
--- !u!114 &-7904595336799709970
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Mochi_lie
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: e2eecce8-81c5-4164-b352-22e822ac4e98
  contextForAI: "El jugador MINTI\xD3 con cari\xF1o (dijo que estaba rico para no
    herirle). Mochi lo nota un poco, pero agradece la intenci\xF3n. Gana algo de
    confianza."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: player_lied_kindly
    value: 1
  - flag: mochi_trust
    value: 1
  nextNodes:
  - {fileID: 4109579688177938548, guid: d01b59844ad2fe142b1640062d04a152, type: 2}
  openingLine: "Qu\xE9 respuesta tan dulce. Casi tan dulce que me preocupa que sea
    mentira. \u2026No te culpo. Una mentira amable es una manta peque\xF1a."
  transitions: []
--- !u!114 &-7902218044835067947
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Mochi_honest
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: d1fe2228-aace-4e21-af72-9d9cce0a326d
  contextForAI: "El jugador prob\xF3 el plato y fue HONESTO (dijo que no est\xE1
    bueno) pero con tacto. Mochi se siente herido y agradecido a la vez; respeta
    la sinceridad."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: player_was_honest
    value: 1
  - flag: mochi_trust
    value: 1
  nextNodes:
  - {fileID: 4109579688177938548, guid: d01b59844ad2fe142b1640062d04a152, type: 2}
  openingLine: "\u2026Ah. Dolor. Pero dolor limpio, como cortarse con un cuchillo
    caro. Gracias. Nadie me destruye de frente desde hace mucho."
  transitions: []
--- !u!114 &-7772422528388462890
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 511426048eb4ebf46b9184e6496e2b8a, type: 3}
  m_Name: Mochi_taste
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.ChoiceNodeSO
  nodeGuid: 95f4e97b-efc7-4b04-845f-8977368bb12d
  contextForAI: "TARDE. Mochi ofrece un risotto experimental amargo y espera reacci\xF3n.
    Decisi\xF3n clave del jugador: honestidad con tacto, mentira amable, crueldad,
    o evasiva."
  prerequisiteFlags:
  - flag: mochi_metida
    expectedValue: 1
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter: []
  nextNodes: []
  openingLine: "Toma. PRU\xC9BALO. Y antes de hablar, recuerda que mi autoestima
    est\xE1 montada con palillos. \xBF\u2026est\xE1 bueno?"
  choices:
  - condition: "el jugador es honesto con tacto (dice que no est\xE1 bueno sin ser
      cruel)"
    nextNode: {fileID: -7902218044835067947}
  - condition: "el jugador miente con cari\xF1o (dice que est\xE1 rico para no herirle)"
    nextNode: {fileID: -7904595336799709970}
  - condition: el jugador es cruel o se burla de la comida
    nextNode: {fileID: -152919930207516124}
  - condition: el jugador evade o no dice nada claro
    nextNode: {fileID: 7454747838331076001}
--- !u!114 &-4310401074370485196
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_refine
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 6d1e0939-e265-412e-815d-99f54ae147f8
  contextForAI: "El jugador le ayud\xF3 a SIMPLIFICAR con criterio. Aster gana confianza
    y aprende algo."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_idea_mejorada
    value: 1
  - flag: player_helped_aster_good
    value: 1
  nextNodes:
  - {fileID: 8346110317872889273}
  openingLine: "\xBFQuitar\u2026 para que respire? No se me hab\xEDa ocurrido. Menos
    es m\xE1s. Gracias, de verdad."
  transitions: []
--- !u!114 &-3447965769781748127
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_grudge
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 1f49ae62-6f62-45d2-b36a-ff769e7266f4
  contextForAI: "El jugador lo neg\xF3 o culp\xF3 a Mochi. Aster se enfada m\xE1s
    y se cierra, fr\xEDo y defensivo."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_angry
    value: 1
  nextNodes:
  - {fileID: 5691390254844099713}
  openingLine: "Vale. Entonces, adem\xE1s de hablar, tambi\xE9n desaparecen palabras
    de tu boca por arte de magia. Fascinante. D\xE9jame con mis estrellas."
  transitions: []
--- !u!114 &-802924246876509574
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_mirror
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 581a21f0-5d64-4966-bd40-510e7f6fca2f
  contextForAI: 'El jugador fue honesto: Aster se esconde en el invento para no enfrentarse
    a lo de verdad. Le duele pero le toca.'
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_idea_mejorada
    value: 1
  - flag: player_was_honest
    value: 1
  nextNodes:
  - {fileID: 8346110317872889273}
  openingLine: "\u2026Auch. No me escondo en el invento. Yo no\u2026 vale. Puede.
    Puede que s\xED. No me mires as\xED."
  transitions: []
--- !u!114 &-152919930207516124
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Mochi_cruel
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: fb3b59b4-9704-4e02-ab22-b23fa0738cd0
  contextForAI: El jugador fue CRUEL con la comida. Le toca una herida profunda.
    Se defiende dolido, sin quedarse a que conviertan su trabajo en un chiste.
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: mochi_offended
    value: 1
  nextNodes:
  - {fileID: 2897729196826193434, guid: d01b59844ad2fe142b1640062d04a152, type: 2}
  openingLine: "Ah. Ya veo. No era una cr\xEDtica. Era una ejecuci\xF3n p\xFAblica.
    Puedes no querer mi comida, pero no me quedo a que la conviertas en chiste."
  transitions: []
