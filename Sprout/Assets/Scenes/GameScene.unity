  m_Script: {fileID: 11500000, guid: b7a014e559d450148bba385b44823e8b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sprout.Presentation.ScriptedDialogue
  lines:
  - id: 1
    speaker: Conductor Paco
    text: "Bueno, bueno\u2026 as\xED que t\xFA eres la nieta de Rosa, \xBFno? La
      que hereda la florister\xEDa. Ya me lo hab\xEDan dicho \u2014 aqu\xED se sabe
      todo antes de que pase."
    choices:
    - text: " S\xED, soy yo."
      goTo: 
      setFlag: 
    - text: "\xBFYa lo sab\xEDan?"
      goTo: 
      setFlag: 
    - text: "Ya\u2026 hola."
      goTo: 
      setFlag: 
  - id: 2
    speaker: Conductor Paco
    text: " Menudo regalo te ha dejado tu abuela, \xBFeh? Una florister\xEDa entera
      pa' ti sola. Yo de flores no entiendo, pero de gente s\xE9 un rato, as\xED
      que cualquier cosa me preguntas a m\xED."
    choices:
    - text: "Lo tendr\xE9 en cuenta."
      goTo: 
      setFlag: 
    - text: Gracias, Paco.
      goTo: 
      setFlag: 
    - text: Ya veremos.
      goTo: 
      setFlag: 
  - id: 3
    speaker: Conductor Paco
    text: "Y otra cosa, que soy muy observador yo: los vecinos son maj\xEDsimos,
      pero cada uno tiene lo suyo, \xBFeh? T\xFA esc\xFAchalos, dales un poco de
      coba, y p'adentro. Es como todo en la vida."
    choices:
    - text: Tienen pinta de ser raros
      goTo: 
      setFlag: 
    - text: "Tu tambi\xE9n tienes to tuyo"
      goTo: 
      setFlag: 
  - id: 5
    speaker: Conductor Paco
    text: "\xBFBueno y t\xFA por que has aceptado venir al campo? "
    choices:
    - text: No me quedaba otra
      goTo: 
      setFlag: 
    - text: La ciudad me agobiaba
      goTo: 
      setFlag: 
  - id: 4
    speaker: Conductor Paco
    text: "Bueno, ya ver\xE1s que aqu\xED te ir\xE1 muy bien. \xA1Te lo digo yo que
      s\xE9 de todo! "
    choices:
    - text: No creo
      goTo: 
      setFlag: 
    - text: "No sabes nada de m\xED"
      goTo: 
      setFlag: 
    - text: "Seguro que s\xED"
      goTo: 
      setFlag: 
  - id: 4
    speaker: Conductor Paco
    text: "\xA1Mira, ya llegamos! \xBFVes qu\xE9 pueblo m\xE1s bonito? Yo no lo cambio
      por nada. Bueno, por un chalet en la playa igual s\xED, pero ya me entiendes. "
    choices: []
  playOnStart: 0
  charsPerSecond: 40
  lockPlayer: 1
  playerTag: Player
  fontSize: 20
  boxHeight: 190
  onFinished:
    m_PersistentCalls:
      m_Calls: []
