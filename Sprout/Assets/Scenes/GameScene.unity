--- !u!114 &5691390254844099713
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_bye
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: e011feb9-1b5c-4f2e-a4f4-917cc0c7dbe3
  contextForAI: "Despedida final del d\xEDa. Antes de irse te sugiere hablar con
    Moth sobre la luz. Terminal."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: recommend_moth
    value: 1
  - flag: glow_aster_none
    value: 1
  nextNodes: []
  openingLine: "Me vuelvo al taller. Oye\u2026 preg\xFAntale a Moth sobre la luz.
    Habla como si desayunara imposibles. Gracias por escuchar."
  transitions: []
--- !u!114 &7454747838331076001
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Mochi_evade
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 4c6ac8c7-2df2-4b3e-88ec-5fce71ffc7d6
  contextForAI: "El jugador evadi\xF3, respuesta neutra o poco clara. Mochi se queda
    inseguro y algo distante."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter: []
  nextNodes:
  - {fileID: 2897729196826193434, guid: d01b59844ad2fe142b1640062d04a152, type: 2}
  openingLine: "\xBF\u2026eso es un s\xED o un no? Bah. Da igual. Olv\xEDdalo."
  transitions: []
