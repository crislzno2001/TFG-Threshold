--- !u!114 &53501542043839701
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_offended
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 83fe9b9c-c469-45dc-879f-bf9071813fde
  contextForAI: "El jugador ignor\xF3 la confesi\xF3n o fue fr\xEDo/cruel. Aster
    se cierra y vuelve al invento para protegerse. Dolido pero disimulando."
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_incomodo
    value: 1
  nextNodes:
  - {fileID: 5691390254844099713}
  openingLine: "Claro. S\xED. Volvamos a las estrellas. Las estrellas no tienen ex,
    eso ayuda. \u2026No pasa nada. De verdad."
  transitions: []
--- !u!114 &501308832602398993
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9bb417fcb585cc4b80fb00beca23d32, type: 3}
  m_Name: Aster_insist
  m_EditorClassIdentifier: Assembly-CSharp::OpenAI.Dialogue.SpeechNodeSO
  nodeGuid: 03fe3770-ec64-4123-8ba9-32b780ae05ae
  contextForAI: Aster decide encenderla para reconquistar a la ex. Puede salir bien
    o doler.
  prerequisiteFlags: []
  lockedReply: "A\uFFFDn no puedes avanzar por aqu\uFFFD."
  resumeLine: 
  flagsOnEnter:
  - flag: aster_insiste
    value: 1
  nextNodes:
  - {fileID: 5691390254844099713}
  openingLine: "Para ella. Tengo que intentarlo. Si no, me preguntar\xE9 siempre\u2026
    \xBFy si hubiera funcionado?"
  transitions: []
